# =====================================================================
# قالب بيئة الإنتاج — مُتقِن (استضافة مشتركة: لا SSH، لا CLI، لا artisan)
# هذا قالب يُرفع للمستودع: صفر أسرار حقيقية — كل القيم الحساسة placeholders.
# انسخه إلى .env على الخادم واملأ القيم يدوياً. (ملفات .env الحقيقية
# مستثناة من git — انظر .gitignore)
# =====================================================================

APP_NAME=مُتقن

# بيئة إنتاج: تُخفي آثار الأخطاء، وتُطفئ dev_otp تلقائياً (شرطه environment('local'))،
# وتُفرغ قائمة الحسابات التجريبية في صفحة الدخول
APP_ENV=production

# إظهار الأخطاء التفصيلية في الإنتاج = تسريب مسارات وأسرار — يبقى false دائماً
APP_DEBUG=false

# ⚠️ مفتاح جديد للإنتاج حصراً — ولّده على جهازك بـ:
#     php artisan key:generate --show
# وألصق الناتج هنا. ممنوع نسخ مفتاح التطوير المحلي: المفتاح المشترك يعني أن
# كل ما شُفّر أو وُقّع محلياً (كوكيز، بيانات مشفّرة) قابل للتزوير في الإنتاج.
APP_KEY=

# دومين الموقع الفعلي (الواجهة والباك على نفس الدومين — الباك في /backend/)
APP_URL=https://REPLACE-ME

# ملاحظة التوقيت: Africa/Tripoli مثبّت مباشرة في config/app.php (سطر 70)
# ولا يُقرأ من env — لا حاجة لأي متغيّر هنا، والقيمة صحيحة كما هي.

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# سجلات يومية مدوّرة تلقائياً (ملف لكل يوم) — بلا CLI لا سبيل لتفريغ ملف
# واحد متضخّم، والتدوير اليومي يحل ذلك من تلقاء نفسه
LOG_CHANNEL=daily
LOG_LEVEL=error

# قاعدة MySQL من لوحة الاستضافة (cPanel غالباً يسبق الأسماء ببادئة الحساب)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=REPLACE_ME_dbname
DB_USERNAME=REPLACE_ME_dbuser
DB_PASSWORD=REPLACE_ME_password

# جلسات على الملفات (storage/framework/sessions): بلا جدول إضافي وبلا أي CLI —
# والمصادقة أصلاً بتوكن Bearer فالجلسات هامشية
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# كاش على الملفات: لا يعتمد على جدول cache ولا يحتاج أي أمر تهيئة أو تفريغ
CACHE_STORE=file

# تنفيذ فوري متزامن: لا queue worker على الاستضافة المشتركة، وsync يجعل أي
# مهمة تُنفَّذ داخل الطلب نفسه (المشروع أصلاً لا يستعمل طوابير — فحص موثّق)
QUEUE_CONNECTION=sync

# لا SMTP على هذه الاستضافة ولا بريد صادر في المشروع أصلاً (الإشعارات داخل
# التطبيق قناة database فقط) — log يكتب أي محاولة بريد للسجل بدل الفشل
MAIL_MAILER=log

# تخزين محلي داخل storage/ — المشروع لا يستعمل Storage::disk('public') ولا
# يحتاج storage:link إطلاقاً (فحص موثّق)، فلا مأزق symlink على الاستضافة
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=log

# أصول CORS المسموحة (مفصولة بفواصل). على نفس الدومين تكون CORS غير مُفعَّلة
# عملياً للطلبات same-origin، لكن ضبطها صراحةً يغلق الباب أمام أي أصل غريب —
# الافتراضي عند تركها فارغة «مغلق» على localhost:8080 فقط (لن يعمل الإنتاج بدونها لو احتاجها)
CORS_ALLOWED_ORIGINS=https://REPLACE-ME
