# =====================================================================
# حجب كل وصول HTTP إلى شجرة لارافيل (.env / vendor / storage / app ...)
# الاستضافة المشتركة تجعل هذا المجلد كله تحت جذر الويب — هذا الملف هو
# السياج. المنح الصريح لمجلد public/ وحده في public/.htaccess.
# الصيغتان معاً حتى يعمل الحجب أياً كانت نسخة Apache عند المستضيف:
#   - Apache 2.4+ : mod_authz_core (Require all denied)
#   - Apache 2.2  : mod_access_compat (Order / Deny from all)
# =====================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    <IfModule mod_access_compat.c>
        Order allow,deny
        Deny from all
    </IfModule>
</IfModule>
